<?xml version="1.0"?>
<!-- mallard-run {"schema":"mallard-run","version":3,"mallard":{"version":"v0.10.0-147-g1fa6e0b05-dirty","git_sha":"1fa6e0b053795995c7c0aaffbe200c9e5a1b853d","git_dirty":true},"build":{"dim":2,"precision":"double","build_type":"Release","compiler":"AppleClang 21.0.0.21000334","cxx_flags":"-O3 -DNDEBUG","kokkos":"5.2.2","backend":"Threads","host_backend":"Threads","mpi":false,"gpu_aware_mpi":false,"nccl":false,"hdf5":false,"hdf5_parallel":false,"kaminpar":false,"species_layout":"right"},"dependencies":{"compiler":"AppleClang 21.0.0.21000334","kokkos":"5.2.2","mpi":null,"hdf5":null,"cgns":null,"zlib":null,"nccl":null,"gpu_runtime":null,"gpu_driver":null},"run":{"run_id":"a19362c7-5c4f-4f1c-ba16-319eee62969a","start_time":"2026-11-20T22:51:30Z","ranks":1,"host":"workstation","device":"Apple M4 Pro","directory":"/home/me/cyl","hosts":1,"restart_of":null},"input":{"file":null,"sha256":"ae0a1487ad289cbaf1015ba50d1c375743d5a128c362d2ab699c2f5637940553","text":"# Flow past a circular cylinder at Re = 100, Mach 0.2: periodic vortex\n# shedding (Karman vortex street). On this mesh, over t = 60..160:\n# St = 0.164, mean Cd = 1.36, lift amplitude 0.33 (references for\n# incompressible flow: St 0.164-0.166, Cd 1.33-1.35, Cl' 0.33).\n# Generate the mesh first (384 x 128 quads):\n#   python ../../tools/mesh/make_cylinder_mesh.py cylinder.msh -\u002dn-theta 384 -\u002dn-r 128 -\u002dr-far 25 -\u002ddr0 0.01\n# Nondimensionalization: cylinder diameter 1, free-stream density and sound\n# speed 1, so U = M = 0.2 and mu = U D / Re.\n\n[[boundaries]]\nname = \"cylinder\"\ntype = \"wall_adiabatic\"\n\n[[boundaries]]\nT = 0.7142857142857143\nname = \"farfield\"\np = 0.7142857142857143\ntype = \"farfield\"\nu = [0.2, 0.0]\n\n[[forces]]\nfile = \"./solut/forces_cylinder.csv\"\ninterval = 20\nzone = \"cylinder\"\n\n[initialize]\np = \"0.7142857142857143\"\nrho = \"1.0\"\ntype = \"analytical\"\n# A transverse kick behind the cylinder: shedding saturates by t = 60\n# (the instability e-folds only every ~50 time units)\nu = [\n     \"0.2 * (1 - exp(-4 * (x^2 + y^2 - 0.25)))\",\n     \"0.1 * exp(-((x - 1.5)^2 + y^2))\",\n]\n\n[mesh]\nfilename = \"cylinder.msh\"\ntype = \"file\"\n\n[numerics]\ncheck_nan = true\nriemann_solver = \"HLLC\"\ntime_integrator = \"SSPRK3\"\n\n[numerics.face_reconstruction]\norder = 3\ntype = \"TENO\"\n\n[output]\ncheck_interval = 2000\n# The free stream of CP and CF, here and in the wall probe below\nreference = {p = 0.7142857142857143, rho = 1.0, u = [0.2, 0.0]}\n\n[physics]\nPr = 0.72\nT_ref = 0.7142857142857143\ngamma = 1.4\nmu = 0.002\np_ref = 0.7142857142857143\nrho_ref = 1.0\ntype = \"navier_stokes\"\nunits = \"nondimensional\"\n\n# Transverse velocity two diameters behind the cylinder (its spectrum gives\n# St), point values of the TENO polynomials every 0.1 time units\n[[probes]]\nfields = [\"U_Y\", \"P\"]\nfile = \"./solut/probe_wake_point.csv\"\nname = \"wake_point\"\npoint = [2.5, 0.0]\nsampling = \"point\"\ntime_interval = 0.1\n\n# Wake survey on an arc of radius 5 behind the cylinder (ParaView reads the\n# .pvd series), with its mean and RMS each time unit\n[[probes]]\nangles = [-45.0, 45.0]\ncenter = [0.0, 0.0]\nfields = [\"U\", \"P\"]\nfile = \"./solut/probe_wake_arc.pvd\"\nformat = \"vtp\"\nn_points = 91\nname = \"wake_arc\"\nradius = 5.0\nreductions = [\"mean\", \"rms\", \"min\", \"max\"]\nreductions_file = \"./solut/probe_wake_arc_reductions.csv\"\nsampling = \"point\"\ntime_interval = 1.0\ntype = \"arc\"\n\n# Wall pressure and skin friction coefficients around the cylinder, ordered\n# along the wall (clockwise, with the arc length s from the first face)\n[[probes]]\nboundary = \"cylinder\"\nfields = [\"CP\", \"CF\", \"Y_PLUS\"]\nfile = \"./solut/probe_wall.csv\"\nname = \"wall\"\ntime_interval = 1.0\n\n[run]\ncfl = 1.0\nt_stop = 160.0\n\n# Phase averages of the shedding cycle from t = 60, in 12 bins of the phase\n# set by the upward zero crossings of U_Y on the wake axis at x = 3: the\n# PHASE_<bin>_<field> output of the last snapshot. Over t = 100..400 the\n# crossings give St = 0.1651 (period 30.29 +- 0.05), the bins equal the\n# probe series binned by tools/post/insitu_statistics.py phase bitwise, and the\n# phase-averaged U_Y at the probe keeps 0.991 of the signal's amplitude (a\n# sinusoid averaged over 1/12 of a period keeps 0.989): no phase jitter.\n[statistics]\ninterval = 10\nt_start = 60.0\n\n[statistics.phase]\nbins = 12\nfields = [\"U_X\", \"U_Y\", \"P\"]\nlevel = 0.0\nprobe = [3.0, 0.0]\nvariable = \"U_Y\"\n\n[[write_data]]\nfields = [\"RHO\", \"U_X\", \"U_Y\", \"P\"]\nprefix = \"./solut/cylinder\"\ntime_interval = 1.0\n\n[[write_data]]\nfields = [\"P\"]\nprefix = \"./solut/wall\"\nregion = \"cylinder\"\ntime_interval = 1.0\n\n# Often, and small: the near wake's cells (with their REGION_FRACTION), and\n# three cuts across the recirculation bubble at x = 1.0, 1.4 and 1.8 (point\n# values of the TENO polynomials: solut/wake_0.vtkhdf, _1, _2), ten times per\n# shedding period\n[[write_data]]\nfields = [\"RHO\", \"U\", \"P\", \"VORTICITY\", \"CP\", \"Q_CRITERION\"]\nprefix = \"./solut/near_wake\"\nregion = {center = [3.0, 0.0], size = [6.0, 3.0], type = \"rectangle\"}\ntime_interval = 0.6\n\n[[write_data]]\nfields = [\"U\", \"P\", \"MASS_FLUX\"]\nprefix = \"./solut/wake\"\nregions = [\n           {bounds = [[0.9, -2.0], [1.1, 2.0]], normal = [1.0, 0.0], point = [1.0, 0.0], type = \"cut_plane\"},\n           {bounds = [[1.3, -2.0], [1.5, 2.0]], normal = [1.0, 0.0], point = [1.4, 0.0], type = \"cut_plane\"},\n           {bounds = [[1.7, -2.0], [1.9, 2.0]], normal = [1.0, 0.0], point = [1.8, 0.0], type = \"cut_plane\"},\n]\ntime_interval = 0.6\n\n[[write_data]]\nfields = [\"PHASE_*\"]\nprefix = \"./solut/phase\"\ntime_interval = 100.0\n\n","resolved":"[[boundaries]]\nname = \"cylinder\"\ntype = \"wall_adiabatic\"\n\n[[boundaries]]\nT = 0.7142857142857143\nname = \"farfield\"\np = 0.7142857142857143\ntype = \"farfield\"\nu = [0.2, 0.0]\n\n[[forces]]\nfile = \"./solut/forces_cylinder.csv\"\ninterval = 20\nzone = \"cylinder\"\n\n[initialize]\nn_subdivisions = 4\np = \"0.7142857142857143\"\nrho = \"1.0\"\ntype = \"analytical\"\nu = [\"0.2 * (1 - exp(-4 * (x^2 + y^2 - 0.25)))\", \"0.1 * exp(-((x - 1.5)^2 + y^2))\"]\n\n[mesh]\ncell_order = \"auto\"\ncurved_geometry = true\nfilename = \"cylinder.msh\"\ntype = \"file\"\n\n[numerics]\ncheck_nan = true\nconvective_flux = \"riemann\"\ndouble_flux = false\nlow_mach_cutoff = 0.1\nriemann_solver = \"HLLC\"\ntime_integrator = \"SSPRK3\"\n\n[numerics.face_reconstruction]\nC_T = -1.0\nbound_preserving = false\ncache_file = \"\"\ncache_single_precision = false\ncharacteristic = true\ncurved_mirrors = false\ncurved_wall_degree = 3\nmax_condition = 100000000.0\norder = 3\nsingle_precision_tables = false\nsmall_stencil_size = 10\nstencil_factor = 2.0\ntroubled_capacity = 1.0\ntroubled_threshold = 0.001\ntroubled_upper = 0.01\ntype = \"TENO\"\n\n[output]\nasync = true\ncheck_interval = 2000\ndivergence_report = \"divergence_report\"\nhash_mesh = true\nhealth = true\nio_threads = 1\nreport = \"report.html\"\nrun_log = \"mallard.jsonl\"\nwrite_stencils = \"\"\n\n[output.reference]\np = 0.7142857142857143\nrho = 1.0\nu = [0.2, 0.0]\n\n[physics]\nPr = 0.72\nT_ref = 0.7142857142857143\naxisymmetric = false\ngamma = 1.4\ngas = \"perfect\"\nmu = 0.002\np_ref = 0.7142857142857143\nrho_ref = 1.0\ntype = \"navier_stokes\"\nunits = \"nondimensional\"\nviscosity_model = \"constant\"\n\n[[probes]]\naverage = false\ncopies = \"combined\"\nfields = [\"U_Y\", \"P\"]\nfile = \"./solut/probe_wake_point.csv\"\nformat = \"csv\"\nname = \"wake_point\"\npoint = [2.5, 0.0]\nreductions = []\nreductions_file = \"probe_wake_point_reductions.csv\"\nsamples = true\nsampling = \"point\"\ntime_interval = 0.1\ntype = \"\"\n\n[[probes]]\nangles = [-45.0, 45.0]\naverage = false\ncenter = [0.0, 0.0]\ncopies = \"combined\"\nfields = [\"U\", \"P\"]\nfile = \"./solut/probe_wake_arc.pvd\"\nformat = \"vtp\"\nn_points = 91\nname = \"wake_arc\"\nradius = 5.0\nreductions = [\"mean\", \"rms\", \"min\", \"max\"]\nreductions_file = \"./solut/probe_wake_arc_reductions.csv\"\nsamples = true\nsampling = \"point\"\ntime_interval = 1.0\ntype = \"arc\"\n\n[[probes]]\naverage = false\nboundary = \"cylinder\"\ncopies = \"combined\"\nfields = [\"CP\", \"CF\", \"Y_PLUS\"]\nfile = \"./solut/probe_wall.csv\"\nformat = \"csv\"\nname = \"wall\"\nreductions = []\nreductions_file = \"probe_wall_reductions.csv\"\nsamples = true\nsampling = \"cell\"\ntime_interval = 1.0\ntype = \"\"\n\n[run]\ncfl = 1.0\ncontrol_file_interval = 0\ncontrol_socket = true\ncuda_graphs = true\nkeep_last_good = true\nn_steps = 0\nstep_queue = 3\nt_stop = 160.0\nt_wall_stop = -1.0\n\n[statistics]\nconditional = []\nfields = []\ninterval = 10\nproducts = []\nreset = false\nt_start = 60.0\n\n[statistics.phase]\nbins = 12\nfields = [\"U_X\", \"U_Y\", \"P\"]\ninterval = 10\nlevel = 0.0\nprobe = [3.0, 0.0]\nt_start = 60.0\nvariable = \"U_Y\"\n\n[[write_data]]\ncompression = \"none\"\nfields = [\"RHO\", \"U_X\", \"U_Y\", \"P\"]\nprefix = \"./solut/cylinder\"\ntime_interval = 1.0\n\n[[write_data]]\nfields = [\"P\"]\nformat = \"vtu\"\nprefix = \"./solut/wall\"\nregion = \"cylinder\"\ntime_interval = 1.0\ntype = \"\"\n\n[[write_data]]\ncompression = \"none\"\nfields = [\"RHO\", \"U\", \"P\", \"VORTICITY\", \"CP\", \"Q_CRITERION\"]\nprefix = \"./solut/near_wake\"\ntime_interval = 0.6\n\n[write_data.region]\ncenter = [3.0, 0.0]\nflip = false\nsize = [6.0, 3.0]\ntype = \"rectangle\"\n\n[[write_data]]\nfields = [\"U\", \"P\", \"MASS_FLUX\"]\nformat = \"vtu\"\nprefix = \"./solut/wake\"\ntime_interval = 0.6\n\n[[write_data.regions]]\nbounds = [[0.9, -2.0], [1.1, 2.0]]\nnormal = [1.0, 0.0]\npoint = [1.0, 0.0]\ntype = \"cut_plane\"\n\n[[write_data.regions]]\nbounds = [[1.3, -2.0], [1.5, 2.0]]\nnormal = [1.0, 0.0]\npoint = [1.4, 0.0]\ntype = \"cut_plane\"\n\n[[write_data.regions]]\nbounds = [[1.7, -2.0], [1.9, 2.0]]\nnormal = [1.0, 0.0]\npoint = [1.8, 0.0]\ntype = \"cut_plane\"\n\n[[write_data]]\ncompression = \"none\"\nfields = [\"PHASE_*\"]\nprefix = \"./solut/phase\"\ntime_interval = 100.0\n"},"mesh":{"type":"file","file":"cylinder.msh","sha256":"b7d744ca0c27abff2ff76eefb2ac112dca71427cd463a6ba599a043933ba6986"},"preset":null} -->
