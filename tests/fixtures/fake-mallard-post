#!/usr/bin/env python3
"""Stands in for `mallard post extract` in the browser tests: writes the probe file Mallard would (a line's
points, or a boundary probe's faces with their arc length) and prints the JSON report."""
import json
import math
import os
import sys

args = sys.argv[1:]
if args[:2] != ["post", "extract"]:
    sys.exit(f"fake mallard: {' '.join(args)}")
out = args[args.index("-o") + 1]
os.makedirs(out, exist_ok=True)
if "--probe" in args:
    name = args[args.index("--probe") + 1]
    rows = ["step,t,face,x,y,s,nx,ny,area,P,CP", "# units: 1,s,1,m,m,m,1,1,m,kg m-1 s-2,1"]
    for k in range(40):
        a = 2 * math.pi * k / 40
        rows.append(f"100,20,{k},{0.5 * math.cos(a)},{0.5 * math.sin(a)},{0.5 * a},1,0,0.08,{1 + math.cos(a)},{1 - 4 * math.sin(a) ** 2}")
else:
    name = args[args.index("--name") + 1]
    rows = ["step,t,point,x,y,P,U_X", "# units: 1,s,1,m,m,kg m-1 s-2,m s-1"]
    for k in range(50):
        x = 0.5 + 0.2 * k
        rows.append(f"100,20,{k},{x},0,{1 - 0.1 / x},{1 - math.exp(-x)}")
path = f"{out}/probe_{name}.csv"
with open(path, "w") as f:
    f.write("\n".join(rows) + "\n")
print(json.dumps({"written": [{"path": path, "kind": "table", "format": "CSV"}]}))
